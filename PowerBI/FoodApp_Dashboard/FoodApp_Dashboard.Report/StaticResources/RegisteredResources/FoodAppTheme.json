{
  "name": "Food App - Fresh Market",
  "dataColors": [
    "#2E6B4F",
    "#E4572E",
    "#F2A541",
    "#7B2D43",
    "#3D7EA6",
    "#6A994E",
    "#C8A27A",
    "#6D597A",
    "#B8ADA1"
  ],
  "background": "#FFFFFF",
  "foreground": "#2B2118",
  "tableAccent": "#2E6B4F",
  "good": "#2E6B4F",
  "neutral": "#F2A541",
  "bad": "#E4572E",
  "maximum": "#2E6B4F",
  "center": "#A9CBB4",
  "minimum": "#F4EFE6",
  "null": "#D9D0C4",
  "hyperlink": "#3D7EA6",
  "visitedHyperlink": "#6D597A",
  "textClasses": {
    "callout": {
      "fontFace": "DIN",
      "fontSize": 24,
      "color": "#1F4D3A"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#2B2118"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 10,
      "color": "#2B2118"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 9,
      "color": "#6E5F52"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#F7F3EC" } },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": { "solid": { "color": "#EFE8DE" } },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E8DFD3" } },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": { "solid": { "color": "#5C4A3A" } },
            "position": "Outer",
            "preset": "Custom",
            "shadowSpread": 0,
            "shadowBlur": 8,
            "angle": 90,
            "shadowDistance": 2,
            "transparency": 88
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#2B2118" } },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 11,
            "bold": false,
            "alignment": "left"
          }
        ],
        "visualHeader": [
          {
            "foreground": { "solid": { "color": "#6E5F52" } },
            "border": { "solid": { "color": "#E8DFD3" } },
            "background": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "categoryAxis": [
          {
            "labelColor": { "solid": { "color": "#6E5F52" } },
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "titleColor": { "solid": { "color": "#6E5F52" } },
            "titleFontFamily": "Segoe UI",
            "titleFontSize": 9
          }
        ],
        "valueAxis": [
          {
            "labelColor": { "solid": { "color": "#9A8B7E" } },
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "titleColor": { "solid": { "color": "#6E5F52" } },
            "titleFontFamily": "Segoe UI",
            "titleFontSize": 9,
            "gridlineColor": { "solid": { "color": "#EFE8DE" } },
            "gridlineStyle": "dotted"
          }
        ],
        "legend": [
          {
            "position": "Top",
            "labelColor": { "solid": { "color": "#6E5F52" } },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ],
        "labels": [
          {
            "color": { "solid": { "color": "#2B2118" } },
            "fontSize": 9,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#1F4D3A" } },
            "fontSize": 24,
            "fontFamily": "DIN"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": { "solid": { "color": "#6E5F52" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "dropShadow": [{ "show": false }],
        "header": [
          {
            "fontColor": { "solid": { "color": "#6E5F52" } },
            "fontFamily": "Segoe UI Semibold",
            "textSize": 9
          }
        ],
        "items": [
          {
            "fontColor": { "solid": { "color": "#2B2118" } },
            "background": { "solid": { "color": "#FFFFFF" } },
            "fontFamily": "Segoe UI",
            "textSize": 10
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#EFE8DE" } },
            "rowPadding": 4
          }
        ],
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backColor": { "solid": { "color": "#2E6B4F" } },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9,
            "wordWrap": true
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#2B2118" } },
            "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "fontColorSecondary": { "solid": { "color": "#2B2118" } },
            "backColorSecondary": { "solid": { "color": "#FAF6F0" } },
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "wordWrap": true
          }
        ],
        "total": [
          {
            "fontColor": { "solid": { "color": "#1F4D3A" } },
            "backColor": { "solid": { "color": "#EAF2EC" } },
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "dropShadow": [{ "show": false }]
      }
    },
    "shape": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }],
        "dropShadow": [{ "show": false }],
        "title": [{ "show": false }]
      }
    },
    "treemap": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#FFFFFF" } },
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "color": { "solid": { "color": "#FFFFFF" } },
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "funnel": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#FFFFFF" } },
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "donutChart": {
      "*": {
        "legend": [{ "show": true, "position": "Bottom" }],
        "slices": [{ "innerRadiusRatio": 62 }]
      }
    },
    "lineClusteredColumnComboChart": {
      "*": {
        "lineStyles": [{ "strokeWidth": 3, "showMarker": true }]
      }
    }
  }
}
